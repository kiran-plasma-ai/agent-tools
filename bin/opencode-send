#!/bin/bash
# Send a command to opencode via tmux
# Usage: opencode-send [-s session] [-w window] "command"

set -e

SESSION="opencode-workspace"
WINDOW=2
COMMAND=""

while [[ $# -gt 0 ]]; do
  case $1 in
    -s|--session)
      SESSION="$2"
      shift 2
      ;;
    -w|--window)
      WINDOW="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: opencode-send [-s session] [-w window] \"command\""
      echo "  -s: tmux session name (default: opencode-workspace)"
      echo "  -w: window number (default: 2)"
      exit 0
      ;;
    *)
      COMMAND="$1"
      shift
      ;;
  esac
done

if [[ -z "$COMMAND" ]]; then
  echo "Error: No command specified"
  exit 1
fi

TARGET="$SESSION:$WINDOW"

# Check if session exists
if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "Error: tmux session '$SESSION' not found"
  echo "Run: tmux-opencode"
  exit 1
fi

# Send the command (with 1s delay like kimi-send)
echo "Sending to opencode: $COMMAND"
tmux send-keys -t "$TARGET" -l -- "$COMMAND"
sleep 1.0
tmux send-keys -t "$TARGET" Enter

echo "Command sent. Use 'tmux capture-pane -t $TARGET -p' to see output."

#!/usr/bin/env python3
"""mdrecall — find existing markdown that already covers a topic, before writing a new file.

Usage:
    mdrecall "underpinning clay" "party wall"
    mdrecall talajtores --root ~/insulation --limit 5
    mdrecall beadvany --json

Scores accent-insensitively by token match in: frontmatter title/description/tags,
headings, filename, and body. It is a candidate finder, not a decision maker:
read the top hits and decide update-vs-new.

Limitation: only inline frontmatter tags (`tags: a, b`) are parsed; the YAML
list form (`tags:` followed by `- a` lines) is ignored.
"""
import argparse
import json
import os
import re
import sys
import time
import unicodedata

SKIP_DIRS = {".git", ".venv", "venv", "node_modules", "__pycache__", ".cache",
             ".mypy_cache", ".ruff_cache", ".pytest_cache", "dist", "build"}
WORDS = re.compile(r"[0-9A-Za-z\u00c0-\u024f]+")


def norm(s: str) -> str:
    s = unicodedata.normalize("NFKD", s.casefold())
    return "".join(c for c in s if not unicodedata.combining(c))


def tokens(s: str):
    return [t for t in WORDS.findall(norm(s)) if len(t) >= 2]


def parse(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            text = f.read(262144)
    except OSError:
        return None
    title = desc = ""
    tags = []
    body = text
    if text.startswith("---"):
        end = text.find("\n---", 3)
        if end != -1:
            fm = text[3:end]
            body = text[end + 4:]
            for line in fm.splitlines():
                key, _, val = line.partition(":")
                key = key.strip().lower()
                val = val.strip().strip('"\'')
                if key == "title":
                    title = val
                elif key == "description":
                    desc = val
                elif key == "tags":
                    tags = [t.strip(" []\"'") for t in val.split(",") if t.strip(" []\"'")]
    headings = [m.group(2).strip() for m in re.finditer(r"^(#{1,6})\s+(.+)$", body, re.M)]
    if not title:
        h1 = re.search(r"^#\s+(.+)$", body, re.M)
        title = h1.group(1).strip() if h1 else ""
    return {
        "title": title,
        "desc": desc,
        "tags": tags,
        "headings": headings,
        "body": body.lower(),
        "mtime": os.path.getmtime(path),
    }


def score_doc(meta, path, query_tokens):
    name = norm(os.path.basename(path))
    title = norm(meta["title"])
    desc = norm(meta["desc"])
    heads = [norm(h) for h in meta["headings"]]
    tags = [norm(t) for t in meta["tags"]]
    body = meta["body"]
    score = 0
    matched = set()
    for tk in query_tokens:
        hit = False
        if tk in name:
            score += 4; hit = True
        if tk in title:
            score += 5; hit = True
        if any(tk in t for t in tags):
            score += 4; hit = True
        if tk in desc:
            score += 2; hit = True
        for h in heads:
            if tk in h:
                score += 3; hit = True
        if len(tk) >= 4:
            count = body.count(tk)
            if count:
                score += min(count, 5); hit = True
        if hit:
            matched.add(tk)
    return score, matched


def main():
    ap = argparse.ArgumentParser(description="Find markdown files that already cover a topic.")
    ap.add_argument("query", nargs="+", help="topic terms (accent-insensitive)")
    ap.add_argument("--root", default=".", help="directory to scan (default: .)")
    ap.add_argument("--limit", type=int, default=10)
    ap.add_argument("--json", action="store_true", dest="as_json")
    ap.add_argument("--min-score", type=int, default=3)
    args = ap.parse_args()

    q = tokens(" ".join(args.query))
    if not q:
        print("mdrecall: query has no usable terms", file=sys.stderr)
        return 2

    rows = []
    for dirpath, dirnames, filenames in os.walk(os.path.abspath(args.root)):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")]
        for fn in filenames:
            if not fn.endswith(".md"):
                continue
            path = os.path.join(dirpath, fn)
            if os.path.getsize(path) > 2_000_000:
                continue
            meta = parse(path)
            if not meta:
                continue
            score, matched = score_doc(meta, path, q)
            if score >= args.min_score:
                rows.append({
                    "score": score,
                    "path": os.path.relpath(path, args.root),
                    "title": meta["title"][:110],
                    "matched": sorted(matched),
                    "headings": meta["headings"][:4],
                    "modified": time.strftime("%Y-%m-%d", time.localtime(meta["mtime"])),
                })
    rows.sort(key=lambda r: (-r["score"], r["path"]))
    rows = rows[: args.limit]

    if args.as_json:
        print(json.dumps(rows, ensure_ascii=False, indent=1))
        return 0
    if not rows:
        print(f"no existing markdown matched: {' '.join(args.query)}")
        print("a new file is justified only if the topic is genuinely absent — record why.")
        return 0
    print(f"candidates for: {' '.join(args.query)}")
    for r in rows:
        print(f"{r['score']:3}  {r['path']}")
        if r["title"]:
            print(f"     title: {r['title']}")
        if r["headings"]:
            print(f"     heads: {' | '.join(h[:70] for h in r['headings'])}")
    print("\nUpdate an existing file unless no candidate covers the question. If new, append a line to knowledge/log.md.")
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/bin/sh
# kimi-code — launch kimi-cli in a named systemd user scope inside
# development.slice. The scope is named after the current directory and the
# session is resumed (-S <dir> --yes), so re-running in the same project
# continues the same session.
THIS=${PWD##*/}
exec systemd-run --user -E PATH="$PATH" \
  -E TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN:-}" \
  -E HOME="$HOME" \
  -E SHELL=/bin/bash \
  --working-directory="$PWD" --pty -u "kimi_${THIS}" --slice development.slice \
  kimi-cli -S "$THIS" --yes "$@"

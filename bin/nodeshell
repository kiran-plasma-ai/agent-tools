#!/bin/sh
# usage: nodeshell [env] — enter a shell as the agent user via machinectl.
# With env: attaches to the project's gg channel and exports OMP_DEBUG for
# omp-debug-trigger. Target user defaults to "node"; override with
# NODESHELL_USER. Display/terminal env vars are forwarded so GUI and
# terminal apps keep working inside the shell.
set -u

target="${NODESHELL_USER:-node}"

if [ $# -gt 1 ]; then
  echo "usage: nodeshell [env]" >&2
  exit 2
fi
env_name="${OMP_DEBUG:-}"
if [ $# -eq 1 ]; then
  case "$1" in
    ""|*[!a-z0-9-]*) echo "nodeshell: invalid env name '$1'" >&2; exit 2 ;;
    *) env_name="$1" ;;
  esac
fi

if [ -n "$env_name" ]; then
  exec machinectl shell \
    --setenv=DISPLAY="$DISPLAY" \
    --setenv=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
    --setenv=XDG_SESSION_TYPE="$XDG_SESSION_TYPE" \
    --setenv=TERM="$TERM" \
    --setenv=TERM_PROGRAM="$TERM_PROGRAM" \
    --setenv=OMP_DEBUG="$env_name" \
    "$target@" /bin/zsh -c "gg connect $env_name"
else
  exec machinectl shell \
    --setenv=DISPLAY="$DISPLAY" \
    --setenv=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
    --setenv=XDG_SESSION_TYPE="$XDG_SESSION_TYPE" \
    --setenv=TERM="$TERM" \
    --setenv=TERM_PROGRAM="$TERM_PROGRAM" \
    "$target@"
fi
